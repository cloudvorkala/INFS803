# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# Vite only exposes variables prefixed with VITE_ to the browser.
# NEVER put AWS secret keys or a Cognito App Client SECRET in here — this file
# is bundled into the client and is publicly readable.
# ---------------------------------------------------------------------------

# Base URL of your teammate's RESTful API (API Gateway stage URL or EC2 host).
# Leave blank while the backend is not deployed — the app falls back to the
# in-memory mock API so the UI still runs.
VITE_API_BASE_URL=

# Auth mode — one of:
#   mock     no AWS needed, local demo accounts (development default)
#   cognito  browser talks to the Cognito User Pool directly via Amplify.
#            /register, /login, /logout belong to Cognito, not your API (11 own routes)
#   api      your backend exposes POST /register, /login, /logout and calls
#            Cognito server-side. All 14 documented routes are yours.
VITE_AUTH_MODE=mock

# --- Only needed when VITE_AUTH_MODE=cognito ---
# From AWS Console > Cognito > User pools > (your pool) > Overview
VITE_COGNITO_USER_POOL_ID=
# From the same pool > App integration > App clients (no client secret)
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=ap-southeast-2
