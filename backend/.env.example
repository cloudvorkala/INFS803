AWS_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_REPLACE
COGNITO_APP_CLIENT_ID=REPLACE
PRODUCTS_TABLE=Paperbound-Products
CARTS_TABLE=Paperbound-Carts
ORDERS_TABLE=Paperbound-Orders
UPLOADS_BUCKET=replace-with-existing-bucket
ALLOWED_ORIGINS=http://localhost:5173
JWKS_CACHE_SECONDS=300
JWKS_TIMEOUT_SECONDS=3
